# CRA exposes REACT_APP_* values publicly in the browser bundle.
# Development (copy this file to .env.local):
REACT_APP_API_URL=http://localhost:8080
# Vercel Production: set this value in the Dashboard, then redeploy:
# REACT_APP_API_URL=https://portfolio-backend-9kf0.onrender.com
# An explicitly empty value uses same-origin /api (Vercel rewrite or nginx).
# Without an override, production uses the existing Render URL automatically.
# Never put RESEND_API_KEY or any server secrets in this repository.
